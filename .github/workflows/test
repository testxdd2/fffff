name: 🧪 Test — Webhook Discord

on:
  workflow_dispatch:           # Permite ejecución manual desde GitHub
  push:
    paths:
      - 'test.py'
      - '.github/workflows/test.yml'

jobs:
  test-webhook:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    
    steps:
      - name: 📥 Checkout del repositorio
        uses: actions/checkout@v4
      
      - name: 🐍 Configurar Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'
      
      - name: 📦 Instalar dependencias
        run: |
          python -m pip install --upgrade pip
          pip install requests
      
      - name: 🧪 Ejecutar test de webhook
        env:
          DISCORD_WEBHOOK_URL: ${{ secrets.DISCORD_WEBHOOK_URL }}
        run: |
          python test.py
      
      - name: ⚠️ Notificar fallo en test
        if: failure()
        uses: slackapi/slack-github-action@v1
        with:
          payload: |
            {
              "text": "❌ El test de webhook falló en ${{ github.repository }}\nEjecución: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}"
            }
        env:
          SLACK_WEBHOOK_URL: ${{ secrets.SLACK_WEBHOOK_URL }}
